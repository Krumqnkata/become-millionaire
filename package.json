{
  "name": "become-millionaire",
  "version": "1.0.0",
  "private": true,
  "description": "„Пътят към милиона“ – браузърна куиз игра: 15 въпроса, 4 жокера, 4 трудности и един милион евро.",
  "type": "module",
  "license": "MIT",
  "author": "Krum",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krumqnkata/become-millionaire.git"
  },
  "homepage": "https://krumqnkata.github.io/become-millionaire/",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx scripts/validate-questions.ts",
    "voice": "tsx scripts/generate-voice.ts",
    "voice:plan": "tsx scripts/generate-voice.ts --dry-run",
    "check": "npm run lint && npm run typecheck && npm run validate && npm test"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
