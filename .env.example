# Copy to .env.local (git-ignored) and fill in, then run `npm run voice`.
# Azure portal → your Speech resource (Free F0) → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Accounts and player-made packs (Firebase). Firebase console → Project settings → Your apps → Web.
# Not secret: the data is protected by firestore.rules. Leave empty to run without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
